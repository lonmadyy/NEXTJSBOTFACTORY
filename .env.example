# BOT FACTORY — переменные окружения
# Скопируйте этот файл в .env.local для локальной разработки.
# В продакшене (Vercel) заданы через Project Settings → Environment Variables.

# ─────────────────────────────────────────────────────────────────────────────
# Google Analytics 4
# Получить ID: https://analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Формат: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Яндекс.Метрика
# Получить ID: https://metrika.yandex.by → Добавить счётчик → тип «Веб-сайт»
# Формат: 12345678 (только цифры, без префиксов).
# Цели создаются вручную в кабинете — тип «JavaScript-событие», имена должны
# совпадать с именами событий из trackEvent (bot_click, sticky_cta_click,
# sticky_cta_view).
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Яндекс.Вебмастер
# Получить токен: https://webmaster.yandex.ru → Добавить сайт → Способ "Мета-тег"
# Скопировать значение атрибута content (не весь тег, только токен)
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────────
# Google Search Console (опционально, основной способ — DNS-TXT)
# Получить токен: https://search.google.com/search-console → Добавить ресурс
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ═════════════════════════════════════════════════════════════════════════════
# TELEGRAM BOT (@botfactoryby_bot)
# Подробная инструкция получения каждого значения — см. SETUP.md
# ═════════════════════════════════════════════════════════════════════════════

# Токен бота от @BotFather
# Получить: написать @BotFather в Telegram → /mybots → @botfactoryby_bot → API Token
# Формат: 1234567890:AAAA...
TG_BOT_TOKEN=

# ID приватного канала/чата, куда падают уведомления о лидах
# Получить: создать приватный канал, добавить бота как админа, переслать любое
# сообщение из канала боту @userinfobot, скопировать "Forwarded from chat: id"
# Формат: -1001234567890 (для каналов — отрицательный)
TG_ADMIN_CHAT_ID=

# Telegram user ID founder'а — для gating команд /check и /redeem
# Получить: написать @userinfobot, скопировать "Id"
# Формат: 123456789 (положительный)
TG_ADMIN_USER_ID=

# Grok API key от xAI
# Получить: https://console.x.ai → API Keys → Create
# Формат: xai-XXXXXXXXXXXXXXXXXX
XAI_API_KEY=

# Neon Postgres connection string (pooled)
# Получить: https://console.neon.tech → Create project → Connection string → "Pooled connection"
# Формат: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Webhook secret — случайная строка для верификации запросов от Telegram
# Сгенерировать: openssl rand -hex 32
# Используется и Telegram'ом (в заголовке X-Telegram-Bot-Api-Secret-Token),
# и /api/bot/webhook/setup (как query token).
WEBHOOK_SECRET=

# Публичный URL сайта (для setWebhook)
# В проде: https://botfactory.by
# Локально (через ngrok): https://abc123.ngrok.io
BOT_PUBLIC_URL=https://botfactory.by
